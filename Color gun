local function setStyle(styleName)
	CurrentStyle = styleName
	local st = StyleMap[styleName] or StyleMap["NORMAL"]

	CurrentLabel.Text = "STYLE: " .. styleName
	SelectActionBtn.Text = "APPLY: " .. styleName
	SelectActionBtn.BackgroundColor3 = st.Primary

	for _, item in ipairs(getRightWaistItems()) do
		applyStyleToGun(item, styleName)
	end

	local equipped = getEquippedTool()
	if equipped then
		ActiveGunTool = equipped
		applyStyleToGun(ActiveGunTool, styleName)
		task.delay(0.15, function()
			if equipped and equipped.Parent and getEquippedTool() == equipped then
				applyStyleToGun(equipped, styleName)
			end
		end)
		StatusLabel.Text = styleName .. " -> [" .. ActiveGunTool.Name .. "]"
	else
		StatusLabel.Text = styleName .. " selected"
	end
end

for _, st in ipairs(STYLES) do
	local btn = Instance.new("TextButton")
	btn.Name = st.Name
	btn.Size = UDim2.new(1, 0, 0, 28)
	btn.BackgroundColor3 = st.Primary
	btn.Text = st.Name
	btn.TextColor3 = (st.Name == "WHITESCOPE" or st.Name == "LIGHTSCOPE" or st.Name == "GHOSTSCOPE") and Color3.fromRGB(20, 20, 25) or Color3.fromRGB(255, 255, 255)
	btn.TextSize = 11
	btn.Font = Enum.Font.GothamBold
	btn.Parent = ScrollList
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	local stroke = Instance.new("UIStroke")
	stroke.Color = st.Secondary
	stroke.Thickness = 2
	stroke.Parent = btn

	btn.MouseButton1Click:Connect(function()
		setStyle(st.Name)
	end)
end

SelectActionBtn.MouseButton1Click:Connect(function()
	setStyle(CurrentStyle)
end)

GunDisplayBtn.MouseButton1Click:Connect(function()
	local target, dist = findNearestGunDisplay()
	if target then
		applyStyleToGun(target, CurrentStyle)
		StatusLabel.Text = "Display: " .. target.Name .. " (" .. dist .. ")"
	else
		StatusLabel.Text = "No GunDisplay nearby"
	end
end)

ResetBtn.MouseButton1Click:Connect(function()
	setStyle("NORMAL")
end)

local function hookCharacter(character)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			ActiveGunTool = child
			applyStyleToGun(child, CurrentStyle)
			task.delay(0.15, function()
				if child and child.Parent then
					applyStyleToGun(child, CurrentStyle)
				end
			end)
			child.DescendantAdded:Connect(function()
				task.defer(function()
					if child and child.Parent then
						applyStyleToGun(child, CurrentStyle)
					end
				end)
			end)
			StatusLabel.Text = "Held: " .. child.Name .. " [" .. CurrentStyle .. "]"
		end
	end)
end

if LocalPlayer.Character then
	hookCharacter(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(hookCharacter)
