local OriginalData = {}

local function isCharacterBodyPart(part)
	if not part:IsA("BasePart") then return true end
	local char = LocalPlayer.Character
	if char and part:IsDescendantOf(char) and not part:FindFirstAncestorOfClass("Tool") then
		local n = part.Name:lower()
		if n:find("hand") or n:find("arm") or n:find("leg") or n:find("foot")
			or n:find("torso") or n:find("head") or n:find("humanoidrootpart") then
			return true
		end
	end
	return false
end

local function snapshot(obj)
	if OriginalData[obj] then return end
	if obj:IsA("BasePart") then
		OriginalData[obj] = { Type = "Part", Color = obj.Color, Material = obj.Material }
	elseif obj:IsA("SpecialMesh") then
		OriginalData[obj] = { Type = "Mesh", VertexColor = obj.VertexColor }
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		OriginalData[obj] = { Type = "Decal", Color3 = obj.Color3 }
	elseif obj:IsA("SurfaceAppearance") then
		OriginalData[obj] = { Type = "Surface", Color = obj.Color }
	end
end

-- Phan chia vung tren sung theo net ve LIGHTSCOPE / GREENSCOPE:
-- Vung danh dau (khung/ruot/nong/vien/chi tiet) -> Primary; phan con lai -> MATTE_WHITE
local function pickPartStyle(styleName, part, st, index)
	local n = part.Name:lower()

	if styleName == "LIGHTSCOPE" or styleName == "GREENSCOPE" then
		local isMarkedRegion = n:find("scope") or n:find("sight") or n:find("neon") or n:find("glow")
			or n:find("trim") or n:find("accent") or n:find("barrel") or n:find("muzzle") or n:find("rail")
			or n:find("stock") or n:find("grip") or n:find("frame") or n:find("guard")
			or (index % 2 == 1)
		if isMarkedRegion then
			return st.Primary, Enum.Material.SmoothPlastic
		else
			return MATTE_WHITE, MATTE_WHITE_MAT
		end
	end

	local isBarrelOrSupport = n:find("barrel") or n:find("guard") or n:find("rail") or n:find("support")
		or n:find("mount") or n:find("spring") or n:find("muzzle") or n:find("bolt") or n:find("iron") or n:find("silver")
	if isBarrelOrSupport then
		return st.Barrel, st.BarrelMat
	end

	local isSecondaryPart = n:find("scope") or n:find("sight") or n:find("neon") or n:find("glow")
		or n:find("trim") or n:find("accent") or n:find("stock") or n:find("grip") or (index % 3 == 0)
	if isSecondaryPart then
		return st.Secondary, st.Mat2
	end

	return st.Primary, st.Mat1
end

local function applyStyleToGun(target, styleName)
	if not target then return end
	local st = StyleMap[styleName] or StyleMap["NORMAL"]
	local idx = 0

	local function paintPart(part)
		if isCharacterBodyPart(part) then return end
		idx += 1
		snapshot(part)

		if styleName == "NORMAL" then
			local orig = OriginalData[part]
			if orig and orig.Type == "Part" then
				part.Color = orig.Color
				part.Material = orig.Material
			end
		else
			local c, m = pickPartStyle(styleName, part, st, idx)
			part.Color = c
			part.Material = m
		end

		for _, child in ipairs(part:GetChildren()) do
			snapshot(child)
			if child:IsA("SpecialMesh") then
				if styleName == "NORMAL" then
					local orig = OriginalData[child]
					if orig and orig.Type == "Mesh" then
						child.VertexColor = orig.VertexColor
					end
				else
					local c = pickPartStyle(styleName, part, st, idx)
					child.VertexColor = Vector3.new(c.R, c.G, c.B)
				end
			elseif child:IsA("Decal") or child:IsA("Texture") then
				snapshot(child)
				child.Color3 = (styleName == "NORMAL")
					and (OriginalData[child] and OriginalData[child].Color3 or Color3.new(1, 1, 1))
					or st.Secondary
			elseif child:IsA("SurfaceAppearance") then
				snapshot(child)
				child.Color = (styleName == "NORMAL")
					and (OriginalData[child] and OriginalData[child].Color or Color3.new(1, 1, 1))
					or st.Primary
			end
		end
	end

	if target:IsA("BasePart") then
		paintPart(target)
	end

	for _, desc in ipairs(target:GetDescendants()) do
		if desc:IsA("BasePart") then
			paintPart(desc)
		elseif (desc:IsA("Decal") or desc:IsA("Texture")) and not (desc.Parent and isCharacterBodyPart(desc.Parent)) then
			snapshot(desc)
			desc.Color3 = (styleName == "NORMAL")
				and (OriginalData[desc] and OriginalData[desc].Color3 or Color3.new(1, 1, 1))
				or st.Secondary
		elseif desc:IsA("SurfaceAppearance") and not (desc.Parent and isCharacterBodyPart(desc.Parent)) then
			snapshot(desc)
			desc.Color = (styleName == "NORMAL")
				and (OriginalData[desc] and OriginalData[child] and OriginalData[desc].Color or Color3.new(1, 1, 1))
				or st.Primary
		elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") then
			desc.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, st.Primary),
				ColorSequenceKeypoint.new(1, st.Secondary),
			})
		end
	end
end

-- Doi mau dan / tia dan / vet dan khi ban (dac biet LIGHTSCOPE: Vang+Trang Neon, GREENSCOPE: Xanh la+Trang Neon)
local function isBulletLike(obj)
	local n = obj.Name:lower()
	return n:find("bullet") or n:find("projectile") or n:find("tracer") or n:find("laser")
		or n:find("bolt") or n:find("slug") or n:find("pellet") or n:find("beam") or n:find("shot")
end

local function styleBulletObject(obj, styleName)
	if styleName == "NORMAL" then return end
	local st = StyleMap[styleName]
	if not st then return end

	local c1 = st.Primary
	local c2 = (styleName == "LIGHTSCOPE" or styleName == "GREENSCOPE") and MATTE_WHITE or st.Secondary

	local function paintBulletNode(node)
		if node:IsA("BasePart") then
			node.Material = Enum.Material.Neon
			-- Ket hop 2 mau cung luc: nen Primary + vien/tia/vet Secondary Neon
			node.Color = c1
			if not node:FindFirstChild("NhiizDualNeonCore") then
				local core = Instance.new("SelectionBox")
				core.Name = "NhiizDualNeonCore"
				core.Adornee = node
				core.Color3 = c2
				core.LineThickness = 0.04
				core.SurfaceColor3 = c2
				core.SurfaceTransparency = 0.65
				core.Parent = node
			end
		elseif node:IsA("Beam") or node:IsA("Trail") or node:IsA("ParticleEmitter") then
			node.LightEmission = 1
			node.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, c1),
				ColorSequenceKeypoint.new(0.5, c2),
				ColorSequenceKeypoint.new(1, c1),
			})
		elseif node:IsA("PointLight") or node:IsA("SpotLight") or node:IsA("SurfaceLight") then
			node.Color = c1
		end
	end

	paintBulletNode(obj)
	for _, d in ipairs(obj:GetDescendants()) do
		paintBulletNode(d)
	end
end

Workspace.DescendantAdded:Connect(function(desc)
	if CurrentStyle == "NORMAL" then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	if isBulletLike(desc) or desc:IsA("Beam") or desc:IsA("Trail") then
		local pos
		if desc:IsA("BasePart") then
			pos = desc.Position
		elseif desc:IsA("Model") then
			pos = desc:GetPivot().Position
		elseif desc.Parent and desc.Parent:IsA("BasePart") then
			pos = desc.Parent.Position
		end
		if pos and (pos - hrp.Position).Magnitude <= 140 then
			task.defer(function()
				if desc and desc.Parent then
					styleBulletObject(desc, CurrentStyle)
				end
			end)
		end
	end
end)

local function getEquippedTool()
	local char = LocalPlayer.Character
	if not char then return nil end
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Tool") then
			return child
		end
	end
	return nil
end

local function getRightWaistItems()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hrp then return {} end

	local list = {}
	for _, child in ipairs(char:GetChildren()) do
		if not child:IsA("Tool") and (child:IsA("Accessory") or child:IsA("Model") or child:IsA("BasePart")) then
			local n = child.Name:lower()
			if n:find("hand") or n:find("arm") or n:find("leg") or n:find("foot") or n:find("torso") or n:find("head") then
				continue
			end
			local namedHip = n:find("waist") or n:find("hip") or n:find("holster") or n:find("gun") or n:find("pistol") or n:find("rifle") or n:find("weapon") or n:find("scope")
			local p = child:IsA("BasePart") and child or (child:IsA("Accessory") and child:FindFirstChild("Handle") or child:FindFirstChildWhichIsA("BasePart", true))
			if p and not isCharacterBodyPart(p) then
				local rel = hrp.CFrame:PointToObjectSpace(p.Position)
				local inRightHip = (rel.X > 0.45 and rel.X < 1.85) and (rel.Y >= -1.35 and rel.Y <= 0.35) and (math.abs(rel.Z) <= 1.15)
				if namedHip or inRightHip then
					table.insert(list, child)
				end
			end
		end
	end
	return list
end

local function findNearestGunDisplay()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local best, bestDist = nil, math.huge
	for _, obj in ipairs(workspace:GetDescendants()) do
		local ln = obj.Name:lower()
		if (ln:find("gundisplay") or ln:find("gun_display") or ln:find("display") or ln:find("weaponstand")) and (obj:IsA("Model") or obj:IsA("BasePart")) then
			local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
			local d = (pos - hrp.Position).Magnitude
			if d < bestDist then
				bestDist = d
				best = obj
			end
		end
	end
	return best, math.floor(bestDist)
end

